# Optional GenAI provider. Saans works fully without these values using its
# deterministic, context-aware local assistant.
#
# Groq (recommended, OpenAI-compatible)
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
#
# Any OpenAI-compatible endpoint also works. Use AI_API_KEY instead of
# GROQ_API_KEY if your provider does not use that name.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# Optional server-side translation for generated plan and assistant copy.
# Keep this server-only. Never use a NEXT_PUBLIC_ prefix.
# Create a fresh key after rotating any key that has been shared publicly.
GOOGLE_TRANSLATE_API_KEY=
